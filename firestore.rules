rules_version = '2';

// Spelledarens telefon avgör allt. Lagen skriver bara sin egen lagprofil och sina drag.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function game(code) {
      return get(/databases/$(database)/documents/games/$(code)).data;
    }

    function isHost(code) {
      return signedIn() && game(code).hostUid == request.auth.uid;
    }

    function isMember(code) {
      return signedIn()
        && exists(/databases/$(database)/documents/games/$(code)/teams/$(request.auth.uid));
    }

    match /games/{code} {
      // Den som känner koden får läsa spelet, men ingen får lista spel.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';

      allow update: if isHost(code)
        && request.resource.data.hostUid == resource.data.hostUid;

      allow delete: if isHost(code);

      match /teams/{uid} {
        allow read: if isHost(code) || isMember(code);

        // Nya lag bara i lobbyn, bara sitt eget dokument och utan tidslinje.
        allow create: if signedIn()
          && uid == request.auth.uid
          && game(code).status == 'lobby'
          && game(code).hostUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'color', 'mascot', 'level', 'connected', 'lastSeen', 'joinedAt', 'pendingSlot'])
          && validProfile(request.resource.data);

        // Laget ändrar namn, maskot, färg, närvaro, vald lucka och sin gissning. Nivån bara i lobbyn.
        // Spelledaren skriver tidslinjen.
        allow update: if isHost(code)
          || (signedIn()
            && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'color', 'mascot', 'level', 'connected', 'lastSeen', 'pendingSlot', 'guess'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['level'])
              || game(code).status == 'lobby')
            // Gissningen ger inga kort, men ska inte gå att ändra efter att svaret visats.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['guess'])
              || game(code).phase == 'placing')
            && validProfile(request.resource.data));

        // Spelledaren tar bort lag, och ett lag får lämna i lobbyn.
        allow delete: if isHost(code)
          || (signedIn() && uid == request.auth.uid && game(code).status == 'lobby');
      }

      match /moves/{moveId} {
        allow read: if isHost(code) || isMember(code);

        // Ett drag per tur: dokument-id är turens nummer, och drag kan inte ändras.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['teamUid', 'turnIndex', 'slotIndex', 'choice', 'createdAt'])
          && request.resource.data.teamUid == request.auth.uid
          && game(code).status == 'playing'
          && game(code).phase == 'placing'
          && game(code).currentTeamUid == request.auth.uid
          && request.resource.data.turnIndex == game(code).turnIndex
          && moveId == string(game(code).turnIndex)
          && validMove(request.resource.data);

        allow update: if false;
        allow delete: if isHost(code);
      }

      // Kortlek och aktuellt kort. Lagen får aldrig läsa här.
      match /private/{doc} {
        allow read, write: if isHost(code);
      }
    }

    function validProfile(data) {
      return data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 24
        && data.color is string
        && data.color.size() <= 16
        // Maskoten är frivillig så att lag från före maskotarna fortfarande går att uppdatera.
        // Med maskot måste färgen vara maskotens.
        && (!('mascot' in data)
          || (data.mascot in mascotColors() && mascotColors()[data.mascot] == data.color))
        && (!('level' in data) || data.level in ['easy', 'hard'])
        && (!('guess' in data)
          || data.guess == null
          || (data.guess.keys().hasOnly(['turnIndex', 'choice'])
            && data.guess.turnIndex is int
            && validChoice(data.guess.choice)));
    }

    // Ett drag är antingen en lucka i tidslinjen eller ett av fyra artistalternativ, aldrig båda.
    // Att draget passar lagets nivå kollar spelledaren: fel sorts drag räknas som fel svar.
    function validMove(data) {
      return ('slotIndex' in data
          && !('choice' in data)
          && data.slotIndex is int
          && data.slotIndex >= 0
          && data.slotIndex <= 15)
        || ('choice' in data
          && !('slotIndex' in data)
          && validChoice(data.choice));
    }

    function validChoice(choice) {
      return choice is int && choice >= 0 && choice <= 3;
    }

    // Maskotarna och färgen som hör till var och en. Samma lista som src/game/mascots.ts.
    function mascotColors() {
      return {
        'kalle': '#e11d48',
        'rickard': '#f97316',
        'kicki': '#eab308',
        'gunnar': '#22c55e',
        'bluesy': '#14b8a6',
        'wilma': '#3b82f6',
        'elvira': '#8b5cf6',
        'frasse': '#ec4899',
        'bosse': '#a16207',
        'ulla': '#64748b'
      };
    }
  }
}
