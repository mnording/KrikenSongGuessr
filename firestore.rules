rules_version = '2';

// Spelledarens telefon avgör allt. Lagen skriver bara sin egen lagprofil och sina drag.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function game(code) {
      return get(/databases/$(database)/documents/games/$(code)).data;
    }

    function isHost(code) {
      return signedIn() && game(code).hostUid == request.auth.uid;
    }

    function isMember(code) {
      return signedIn()
        && exists(/databases/$(database)/documents/games/$(code)/teams/$(request.auth.uid));
    }

    match /games/{code} {
      // Den som känner koden får läsa spelet, men ingen får lista spel.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';

      allow update: if isHost(code)
        && request.resource.data.hostUid == resource.data.hostUid;

      allow delete: if isHost(code);

      match /teams/{uid} {
        allow read: if isHost(code) || isMember(code);

        // Nya lag bara i lobbyn, bara sitt eget dokument och utan tidslinje.
        allow create: if signedIn()
          && uid == request.auth.uid
          && game(code).status == 'lobby'
          && game(code).hostUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'color', 'mascot', 'level', 'connected', 'lastSeen', 'joinedAt', 'pendingSlot'])
          && validProfile(request.resource.data);

        // Laget ändrar namn, maskot, färg, närvaro, vald lucka och sin gissning. Nivån bara i lobbyn.
        // Spelledaren skriver tidslinjen.
        allow update: if isHost(code)
          || (signedIn()
            && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'color', 'mascot', 'level', 'connected', 'lastSeen', 'pendingSlot', 'guess', 'taunt', 'streakChoice'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['level'])
              || game(code).status == 'lobby')
            // Gissningen ger inga kort, men ska inte gå att ändra efter att svaret visats.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['guess'])
              || game(code).phase == 'placing')
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['taunt'])
              || validTaunt(code, uid, request.resource.data.taunt, resource.data))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['streakChoice'])
              || validStreakChoice(code, uid, request.resource.data.streakChoice, resource.data))
            && validProfile(request.resource.data));

        // Spelledaren tar bort lag, och ett lag får lämna i lobbyn.
        allow delete: if isHost(code)
          || (signedIn() && uid == request.auth.uid && game(code).status == 'lobby');
      }

      match /moves/{moveId} {
        allow read: if isHost(code) || isMember(code);

        // Ett drag per tur: dokument-id är turens nummer, och drag kan inte ändras.
        // createdAt är serverns tid, så att snabblägets ångerfönster inte går att flytta.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['teamUid', 'turnIndex', 'slotIndex', 'choice', 'createdAt'])
          && request.resource.data.teamUid == request.auth.uid
          && game(code).status == 'playing'
          && game(code).phase == 'placing'
          && game(code).currentTeamUid == request.auth.uid
          && request.resource.data.turnIndex == game(code).turnIndex
          && moveId == string(game(code).turnIndex)
          && validMove(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if false;

        // Snabbläget: laget får ångra sitt drag i fem sekunder. Sedan är det låst och avslöjas.
        allow delete: if isHost(code)
          || (signedIn()
            && resource.data.teamUid == request.auth.uid
            && game(code).phase == 'placing'
            && game(code).settings.get('fastMode', false) == true
            && request.time < resource.data.createdAt + duration.value(5, 's'));
      }

      // Kortlek och aktuellt kort. Lagen får aldrig läsa här.
      match /private/{doc} {
        allow read, write: if isHost(code);
      }
    }

    function validProfile(data) {
      return data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 24
        && data.color is string
        && data.color.size() <= 16
        // Maskoten är frivillig så att lag från före maskotarna fortfarande går att uppdatera.
        // Med maskot måste färgen vara maskotens.
        && (!('mascot' in data)
          || (data.mascot in mascotColors() && mascotColors()[data.mascot] == data.color))
        && (!('level' in data) || data.level in ['easy', 'hard'])
        && (!('guess' in data)
          || data.guess == null
          || (data.guess.keys().hasOnly(['turnIndex', 'choice'])
            && data.guess.turnIndex is int
            && validChoice(data.guess.choice)));
    }

    // Ett drag är antingen en lucka i tidslinjen eller ett av fyra artistalternativ, aldrig båda.
    // Att draget passar lagets nivå kollar spelledaren: fel sorts drag räknas som fel svar.
    function validMove(data) {
      return ('slotIndex' in data
          && !('choice' in data)
          && data.slotIndex is int
          && data.slotIndex >= 0
          && data.slotIndex <= 15)
        || ('choice' in data
          && !('slotIndex' in data)
          && validChoice(data.choice));
    }

    // En pik medan ett annat lag gissar, eller en reaktion efter avslöjandet (från alla lag).
    // Bara färdiga texter, och högst en var åttonde sekund. Tiden kommer från servern,
    // så spärren går inte att fuska förbi.
    function validTaunt(code, uid, taunt, before) {
      return taunt.keys().hasOnly(['id', 'at', 'turnIndex'])
        && taunt.keys().hasAll(['id', 'at', 'turnIndex'])
        && taunt.at == request.time
        && game(code).status == 'playing'
        && ((game(code).phase == 'placing'
            && game(code).currentTeamUid != uid
            && taunt.id in ['sakert', 'alla', 'ojoj', 'tick', 'tittar', 'snyggt', 'signatur'])
          || (game(code).phase == 'revealed'
            && taunt.id in ['grattis', 'proffs', 'starkt', 'ojda', 'klurig', 'nasta', 'tack', 'latt', 'vanta', 'nastavar'])
          // Fortsätt eller lås: de andra lagen hetsar laget som väljer.
          || (game(code).phase == 'revealed'
            && game(code).settings.get('streak', false) == true
            && game(code).currentTeamUid != uid
            && game(code).lastResult.correct == true
            && game(code).lastResult.reachedTarget == false
            && taunt.id in ['fortsatt', 'lasin', 'vagar', 'girig']))
        && taunt.turnIndex == game(code).turnIndex
        && (!('taunt' in before)
          || before.taunt == null
          || request.time > before.taunt.at + duration.value(8, 's'));
    }

    // Fortsätt eller lås: bara laget i tur, efter dess eget rätta svar som inte gav vinst, och bara när
    // inställningen är på. Tiden är serverns. Spelledaren kollar själv att det finns kort kvar.
    function validStreakChoice(code, uid, choice, before) {
      return choice.keys().hasAll(['turnIndex', 'action', 'at'])
        && choice.at == request.time
        && choice.turnIndex == game(code).turnIndex
        && game(code).status == 'playing'
        && game(code).phase == 'revealed'
        && (choice.action == 'undone'
          ? undoStreakChoice(choice, priorStreakChoice(before, choice.turnIndex))
          : newStreakChoice(code, uid, choice, priorStreakChoice(before, choice.turnIndex)));
    }

    // Lagets förra val under samma tur, eller null.
    function priorStreakChoice(before, turnIndex) {
      return 'streakChoice' in before && before.streakChoice != null && before.streakChoice.turnIndex == turnIndex
        ? before.streakChoice
        : null;
    }

    // Ångra: inom tre sekunder och bara en gång per tur, så att ingen kan hålla spelet stilla.
    function undoStreakChoice(choice, prior) {
      return choice.keys().hasOnly(['turnIndex', 'action', 'at'])
        && prior != null
        && prior.action in ['continue', 'lock']
        && !('undone' in prior)
        && request.time < prior.at + duration.value(3, 's');
    }

    // Ett nytt val när inget gäller för turen, eller ett sista val efter att ha ångrat (märkt undone).
    function newStreakChoice(code, uid, choice, prior) {
      return choice.keys().hasOnly(['turnIndex', 'action', 'at', 'undone'])
        && choice.action in ['continue', 'lock']
        && game(code).settings.get('streak', false) == true
        && game(code).currentTeamUid == uid
        && game(code).lastResult.teamUid == uid
        && game(code).lastResult.correct == true
        && game(code).lastResult.reachedTarget == false
        && (prior == null
          ? !('undone' in choice)
          : prior.action == 'undone' && choice.get('undone', false) == true);
    }

    function validChoice(choice) {
      return choice is int && choice >= 0 && choice <= 3;
    }

    // Maskotarna och färgen som hör till var och en. Samma lista som src/game/mascots.ts.
    function mascotColors() {
      return {
        'kalle': '#e11d48',
        'rickard': '#f97316',
        'kicki': '#eab308',
        'gunnar': '#22c55e',
        'bluesy': '#14b8a6',
        'wilma': '#3b82f6',
        'elvira': '#8b5cf6',
        'frasse': '#ec4899',
        'bosse': '#a16207',
        'ulla': '#64748b'
      };
    }
  }
}
